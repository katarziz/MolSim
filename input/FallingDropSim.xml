<?xml version="1.0" encoding="UTF-8"?>

<Molsim_Input xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="input.xsd">
    <Parameters>
        <delta_t>0.0005</delta_t>
        <t_end>40</t_end>
        <grav>-12.44</grav>
        <checkpoint_freq/>
        <box_size>
            <x-size>303</x-size>
            <y-size>180</y-size>
            <z-size>0</z-size>
        </box_size>
        <boundary_conditions>
            <top_bound>ref</top_bound>
            <right_bound>ref</right_bound>
            <bottom_bound>ref</bottom_bound>
            <left_bound>ref</left_bound>
            <front_bound>ref</front_bound>
            <back_bound>ref</back_bound>
        </boundary_conditions>
        <cutoff>3.0</cutoff>
        <writer/>
        <force/>
        <output_name>FallingDrop</output_name>
        <output_frequency/>
    </Parameters>
    <ThermostatParams>
        <T_init>0</T_init>
        <T_targ>0.5</T_targ>
        <f_therm>1000</f_therm>
        <delta_T>0</delta_T>
    </ThermostatParams>
    <Particles>
        <disc>
            <position>
                <x-coordinate>150</x-coordinate>
                <y-coordinate>150</y-coordinate>
                <z-coordinate>0</z-coordinate>
            </position>
            <velocity>
                <x-velocity>0</x-velocity>
                <y-velocity>0</y-velocity>
                <z-velocity>0</z-velocity>
            </velocity>
            <radius>20</radius>
            <mass>1.0</mass>
            <type>0</type>
            <eps>1.0</eps>
            <sigma>1.2</sigma>
            <spacing>1.2</spacing>
        </disc>
        <checkpoint>
            <checkpoint_file>checkpoint.bin</checkpoint_file>
        </checkpoint>
    </Particles>
</Molsim_Input>