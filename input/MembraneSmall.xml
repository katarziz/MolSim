<?xml version="1.0" encoding="UTF-8"?>

<Molsim_Input xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="input.xsd">
    <Parameters>
        <delta_t>0.01</delta_t>
        <t_end>500</t_end>
        <grav>-0.001</grav>
        <container>LinkedCell</container>
        <checkpoint_freq>10000</checkpoint_freq>
        <box_size>
            <x-size>45</x-size>
            <y-size>45</y-size>
            <z-size>45</z-size>
        </box_size>
        <boundary_conditions>
            <top_bound>out</top_bound>
            <right_bound>out</right_bound>
            <bottom_bound>out</bottom_bound>
            <left_bound>out</left_bound>
            <front_bound>ref</front_bound>
            <back_bound>ref</back_bound>
        </boundary_conditions>
        <cutoff>4</cutoff>
        <writer/>
        <force/>
        <output_name>MembraneSmall</output_name>
        <output_frequency>5</output_frequency>
        <statistics_freq>0</statistics_freq>
    </Parameters>
    <ThermostatParams>
        <T_init>0</T_init>
        <T_targ>0</T_targ>
        <f_therm>0</f_therm>
        <delta_T>0</delta_T>
    </ThermostatParams>
    <Particles>
        <membrane>
            <base_coordinates>
                <x-coordinate>15</x-coordinate>
                <y-coordinate>15</y-coordinate>
                <z-coordinate>1.5</z-coordinate>
            </base_coordinates>
            <plane>xy</plane>
            <number_particles>
                <width>10</width>
                <height>10</height>
            </number_particles>
            <velocity>
                <x-velocity>0</x-velocity>
                <y-velocity>0</y-velocity>
                <z-velocity>0</z-velocity>
            </velocity>
            <spacing>2.2</spacing>
            <mass>1.0</mass>
            <type>0</type>
            <eps>1</eps>
            <sigma>1</sigma>
            <r_zero>2.2</r_zero>
            <k>300</k>
            <F_mem>
                <F_up>0.8</F_up>
                <Area>
                    <width_begin>4</width_begin>
                    <width_end>5</width_end>
                    <height_begin>4</height_begin>
                    <height_end>5</height_end>
                </Area>
            </F_mem>
        </membrane>
    </Particles>
    </Molsim_Input>
