<?xml version="1.0" encoding="UTF-8"?>

<Molsim_Input xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="input.xsd">
    <Parameters>
        <delta_t>0.005</delta_t>
        <t_end>1.0</t_end>
        <box_size>
            <x-size/>
            <y-size/>
            <z-size/>
        </box_size>
        <number_cells>
            <x-number>180</x-number>
            <y-number>90</y-number>
            <z-number>1</z-number>
        </number_cells>
        <boundary_conditions>
            <top_bound/>
            <right_bound/>
            <bottom_bound/>
            <left_bound/>
        </boundary_conditions>
        <cutoff>3.0</cutoff>
        <writer/>
        <force/>
        <output_name>timetest</output_name>
        <output_frequency/>
    </Parameters>
    <Particles>
        <cuboid>
            <base_coordinates>
                <x-coordinate>0.0</x-coordinate>
                <y-coordinate>0.0</y-coordinate>
                <z-coordinate>0.0</z-coordinate>
            </base_coordinates>
            <number_particles>
                <x-number>32</x-number>
                <y-number>32</y-number>
                <z-number>1</z-number>
            </number_particles>
            <velocity>
                <x-velocity>0.0</x-velocity>
                <y-velocity>0.0</y-velocity>
                <z-velocity>0.0</z-velocity>
            </velocity>
            <spacing>1.0</spacing>
            <mass>1.0</mass>
            <brownian_vel>0.1</brownian_vel>
        </cuboid>
    </Particles>
</Molsim_Input>