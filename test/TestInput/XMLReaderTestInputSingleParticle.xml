<?xml version="1.0" encoding="UTF-8"?>

<Molsim_Input xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="../../input/input.xsd">
    <Parameters>
        <delta_t/>
        <t_end/>
        <box_size>
            <x-size/>
            <y-size/>
            <z-size/>
        </box_size>
        <number_cells>
            <x-number/>
            <y-number/>
            <z-number/>
        </number_cells>
        <boundary_conditions>
            <top_bound/>
            <right_bound/>
            <bottom_bound/>
            <left_bound/>
